# ═══════════════════════════════════════════════════════════════
#  APEX CODING AGENT — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ── LLM Provider ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APEX_MODEL=claude-sonnet-4-20250514
APEX_MAX_TOKENS=8192
APEX_TEMPERATURE=0.3

# ── API Server ──────────────────────────────────────────────────
APEX_HOST=0.0.0.0
APEX_PORT=8000
APEX_WORKERS=4
APEX_API_KEY=your-api-key-here

# ── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# ── Code Sandbox ────────────────────────────────────────────────
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_USE_DOCKER=false
SANDBOX_DOCKER_IMAGE=python:3.12-slim

# ── Observability ──────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=apex-coding-agent
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Agent Tuning ────────────────────────────────────────────────
MAX_RETRY_ATTEMPTS=3
MAX_DEBUG_LOOPS=3
REVIEW_SCORE_THRESHOLD=7.0
COMPLEXITY_SCORE_THRESHOLD=8.0
